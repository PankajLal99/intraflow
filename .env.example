# =============================================================================
# IntraFlow Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your values
# IMPORTANT: Never commit .env to version control!

# =============================================================================
# DATABASE CONFIGURATION (External PostgreSQL)
# =============================================================================
# For AWS/Azure deployment with existing PostgreSQL instance

# Database connection (use your existing AWS/Azure PostgreSQL)
DB_HOST=your-postgres-host.amazonaws.com        # Or Azure PostgreSQL host
DB_PORT=5432
DB_NAME=intraflow_production
DB_USER=postgres                                 # Or your database username
DB_PASSWORD=your_secure_database_password

# Constructed DATABASE_URL (SQLAlchemy format)
# Format: postgresql+asyncpg://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=postgresql+asyncpg://${DB_USER}:${DB_PASSWORD}@${DB_HOST}:${DB_PORT}/${DB_NAME}

# Alternative: Direct DATABASE_URL (uncomment and use this if preferred)
# DATABASE_URL=postgresql+asyncpg://postgres:yourpassword@your-host.rds.amazonaws.com:5432/intraflow

# =============================================================================
# REDIS CONFIGURATION
# =============================================================================
# For message queue and caching

# Option 1: Use local Redis (if running on same server)
REDIS_URL=redis://localhost:6379/0

# Option 2: Use AWS ElastiCache or Azure Cache for Redis (uncomment if using)
# REDIS_URL=redis://your-redis-endpoint.cache.amazonaws.com:6379/0

# =============================================================================
# APPLICATION SECRETS
# =============================================================================
# Generate secure random strings for these (use: openssl rand -hex 32)

# JWT Authentication Secret (REQUIRED - generate a secure random string)
JWT_SECRET=REPLACE_WITH_SECURE_RANDOM_STRING_32_CHARS_OR_MORE

# JWT Token Expiration (in minutes)
JWT_EXPIRATION_MINUTES=1440

# Webhook HMAC Secret (REQUIRED - generate a secure random string)
WEBHOOK_SECRET=REPLACE_WITH_SECURE_RANDOM_STRING_32_CHARS_OR_MORE

# =============================================================================
# LLM PROVIDER API KEYS
# =============================================================================
# Add your LLM provider API keys (at least one required)

# OpenAI API Key (GPT-4, GPT-3.5)
OPENAI_API_KEY=sk-your-openai-api-key-here

# Anthropic API Key (Claude) - Optional
# ANTHROPIC_API_KEY=sk-ant-your-anthropic-api-key-here

# Google AI API Key (Gemini) - Optional
# GOOGLE_API_KEY=your-google-api-key-here

# Default LLM Provider (openai, anthropic, or google)
DEFAULT_LLM_PROVIDER=openai

# Default LLM Model
DEFAULT_LLM_MODEL=gpt-4o-mini

# =============================================================================
# OPENWA CONFIGURATION
# =============================================================================
# WhatsApp integration via OpenWA

# OpenWA API Base URL (default for Docker: http://openwa:2785)
OPENWA_API_URL=http://localhost:2785

# OpenWA API Key (optional, if you've secured OpenWA)
OPENWA_API_KEY=

# =============================================================================
# APPLICATION SETTINGS
# =============================================================================

# Environment (development, staging, production)
ENVIRONMENT=production

# Debug mode (true/false) - NEVER use true in production!
DEBUG=false

# Application Host and Port
HOST=0.0.0.0
PORT=8000

# CORS Origins (comma-separated, or * for all - use specific domains in production)
CORS_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# Frontend URL (for redirects and CORS)
FRONTEND_URL=https://yourdomain.com

# =============================================================================
# RATE LIMITING
# =============================================================================

# Rate limit per tenant (requests per minute)
RATE_LIMIT_PER_MINUTE=100

# Rate limit per IP (requests per minute)
RATE_LIMIT_IP_PER_MINUTE=300

# =============================================================================
# MONITORING AND LOGGING
# =============================================================================

# Log Level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO

# Sentry DSN (optional - for error tracking)
# SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id

# =============================================================================
# OPTIONAL SERVICES
# =============================================================================

# AWS S3 for file storage (optional)
# AWS_ACCESS_KEY_ID=your-aws-access-key
# AWS_SECRET_ACCESS_KEY=your-aws-secret-key
# AWS_S3_BUCKET=your-bucket-name
# AWS_REGION=us-east-1

# Email Configuration (optional - for notifications)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASSWORD=your-app-password
# SMTP_FROM_EMAIL=noreply@yourdomain.com

# =============================================================================
# SECURITY SETTINGS
# =============================================================================

# Password hashing cost factor (10-14, higher = more secure but slower)
BCRYPT_ROUNDS=12

# Session timeout (in seconds)
SESSION_TIMEOUT=3600

# Maximum request body size (in MB)
MAX_REQUEST_SIZE_MB=10

# =============================================================================
# DEPLOYMENT CONFIGURATION
# =============================================================================

# Server Name (for identification)
SERVER_NAME=intraflow-prod-01

# Health Check Endpoint (for load balancers)
HEALTH_CHECK_PATH=/health

# Metrics Endpoint (for Prometheus)
METRICS_PATH=/metrics

# =============================================================================
# SAMPLE VALUES FOR QUICK TESTING (DELETE IN PRODUCTION!)
# =============================================================================
# Uncomment these ONLY for local testing, NEVER in production

# DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/intraflow
# REDIS_URL=redis://localhost:6379/0
# JWT_SECRET=test_jwt_secret_please_change_in_production
# WEBHOOK_SECRET=test_webhook_secret_please_change_in_production
# OPENAI_API_KEY=sk-test-key
# DEBUG=true
# ENVIRONMENT=development
