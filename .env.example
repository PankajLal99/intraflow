# ==============================================
# IntraFlow - Configuration
# Automate Your Internal Communications with AI
# ==============================================

# Security Secrets (Auto-generated by quick-start.sh)
WEBHOOK_SECRET=change-this-to-a-random-secret-string
JWT_SECRET=change-this-to-a-random-jwt-secret

# OpenWA API Key (generated in OpenWA dashboard)
OPENWA_API_KEY=owa_k1_your_api_key_here

# LLM Configuration
# Choose one: openai, anthropic, google, or ollama (for local)
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini

# OpenAI Configuration (if using OpenAI)
OPENAI_API_KEY=sk-your-openai-api-key-here

# Anthropic Configuration (if using Claude)
ANTHROPIC_API_KEY=sk-ant-your-anthropic-api-key-here

# Google Configuration (if using Gemini)
GOOGLE_API_KEY=your-google-api-key-here

# LLM Settings
LLM_TEMPERATURE=0.7
MAX_TOKENS=500

# Grafana Admin Password
GRAFANA_PASSWORD=admin

# External API Configuration (for your business logic)
# Product Search API
PRODUCT_API_URL=https://api.yourcompany.com/products
PRODUCT_API_KEY=your-product-api-key

# Order Management API
ORDER_API_URL=https://api.yourcompany.com/orders
ORDER_API_KEY=your-order-api-key

# Rate Limiting
RATE_LIMIT_PER_MINUTE=60
MAX_RETRIES=3

# ==============================================
# Usage Instructions:
# ==============================================
# 1. Copy this file to .env:
#    cp .env.example .env
#
# 2. Fill in your actual API keys and secrets
#
# 3. Generate a random webhook secret:
#    openssl rand -hex 32
#
# 4. Get your LLM API keys:
#    - OpenAI: https://platform.openai.com/api-keys
#    - Anthropic: https://console.anthropic.com/
#    - Google: https://makersuite.google.com/app/apikey
#
# 5. Configure your business APIs (products, orders, etc.)
#
# 6. Start the services:
#    docker-compose up -d
# ==============================================
